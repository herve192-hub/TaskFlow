<!--
Executable native Spring Cloud Config Server with Eureka registration and shared
infrastructure authentication. Reads backend/config-repo at runtime rather than
embedding credentials in the JAR. Boot packaging supplies the Docker runtime;
config client libraries belong in downstream service modules.
-->

<!-- Herve Chendjou -->
<!-- this pom file contains the dependencies for the config server -->
<!-- it allows the application to fetch configuration from a remote source -->
<!-- backend/infrastructure/config-server -->
<project>

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.taskflow</groupId>
		<artifactId>taskflow-backend</artifactId>
		<version>1.0.0</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>

	<artifactId>config-server</artifactId>
	
	<name>Taskflow Config Server</name>
	
	<description>Config Server for TaskFlow</description>

	<dependencies>
        <dependency>
            <groupId>com.taskflow</groupId>
            <artifactId>common-security</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
		<!-- Spring Boot Actuator dependency -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Spring Cloud Config Server dependency -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-config-server</artifactId>
		</dependency>
		<!-- Eureka Client dependency -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
		<!-- Development Tools dependency -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<!-- Test Dependencies -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
