# Backend image build-context boundary used by every Java service Dockerfile.
# Exclude local secrets, build/test output, editor state, and private diagnostics
# before Docker receives backend/. Maven builds the selected module from source;
# committed config-repo files remain available for the separate runtime mount.
# Keep patterns aligned with .gitignore and publication policy when adding artifacts.

# VCS and local tooling
.git
.gitignore
.vscode/
.idea/
.codex/
.agents/
.aws/
.azure/
.kube/
.ssh/
.gnupg/
.netrc
.git-credentials

# Build outputs
**/target/
**/build/
**/out/
**/node_modules/
**/__pycache__/
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/

# Never send local configuration, credentials, or private data to a builder
**/.env*
**/*.env
**/*.env.*
**/secrets/
**/.secrets/
**/credentials/
**/*.pem
**/*.key
**/*.private-key
**/*.password
**/client.properties
**/.htpasswd
**/.credentials
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/id_rsa*
**/id_ed25519*
**/data/
**/backups/
**/*.db
**/*.sqlite*
**/*.dump
**/*.sql
**/*.bson
**/*.rdb
**/*.aof
**/*.har
**/*.hprof
**/*.heapdump
**/*.bak
**/*.backup
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.log
**/logs/
**/*.sarif
**/security-*.json
**/trivy*.json
**/gitleaks*-report.json
**/codeql-results/

# OS/editor noise
.DS_Store
Thumbs.db
