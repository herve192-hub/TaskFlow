// Browser source type-checking contract for src/, including React JSX and Vite types.
// Strict checks validate application DTOs/hooks; DOM libraries describe browser APIs.
// Bundler resolution matches Vite. noEmit avoids competing with Vite's output, and
// incremental metadata stays under ignored node_modules rather than publishable source.
{
  "compilerOptions": {
    // Cache compiler metadata with dependencies so it stays outside publishable source files.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true, // Vite produces the JavaScript bundle; TypeScript performs type checking.
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
