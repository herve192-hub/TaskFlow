// Node tooling type-checking contract for build/test configs and browser-test helpers.
// Node globals belong here rather than the browser source environment. Strict unused
// checks catch stale tooling; bundler resolution matches the config loaders. This
// project emits no runtime files and stores incremental metadata with dependencies.
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"], // Vite, test configuration, and E2E helpers run in the Node environment.
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Keep test-runner and full-stack helpers type-checked even though they are outside src/.
  "include": ["vite.config.ts", "vitest.config.ts", "playwright*.config.ts", "e2e/**/*.ts"]
}
